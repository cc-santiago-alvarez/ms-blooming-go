# Plantilla de variables de entorno: mantener títulos y agrupamientos al agregar claves.
# Copiar al .env del entorno y pedir los valores al equipo.
# ENV y las claves vacías son requeridas (si falta alguna, el proceso no arranca), salvo
# BLOOMING_ADMIN_EMAILS, que es opcional. Los demás valores cargados son los defaults.
# Detalle de cada variable: docs/migracion-blooming/specs/00-plataforma-base.spec.md §5.

# ENVIRONMENT (development, testing o production; se declara en .env y elige el .env.<ENV> que se carga)
ENV=development

# SERVER
API_NAME=
API_PORT=
API_SECRET=
API_DEBUG=false

# CORS (orígenes separados por coma; acepta *.dominio.com, o * para cualquiera en development/testing)
CORS_ORIGINS=

# DB MONGO (replica set, necesario para las transacciones)
FA_MONGO_URL=
FA_MONGO_DBNAME=
FA_MONGO_DEBUG=false

# MS OAUTH (OAUTH_URL = http://<ms-oauth>/api/v1)
OAUTH_URL=
OAUTH_SECRET=

# MS NOTIFICATION
MS_NOTIFICATION_URL=
MS_NOTIFICATION_SECRET=

# MS EXPORTER
MS_EXPORTER_URL=
MS_EXPORTER_SECRET=

# BLOOMING (BLOOMING_ADMIN_EMAILS: destinatarios del aviso de retiro al admin, separados por coma)
BLOOMING_ADMIN_EMAILS=
DEFAULT_UTC_DIFF=-5
BULK_PURCHASE_MAX_QUANTITY=100
