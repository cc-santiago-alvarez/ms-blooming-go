# Plantilla de variables de entorno: mantener títulos y agrupamientos al agregar claves.
# Copiar al .env del entorno y pedir los valores al equipo.

# ENVIRONMENT
ENV=development

# SERVER
API_NAME=
API_PORT=
API_SECRET=
API_DEBUG=true
ENABLE_REQUEST_LOG=true

# GOOSE (MIGRACIONES CLI)
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://user:password@localhost:5432/petty_cash_dev?sslmode=disable

# DB MONGO
FA_MONGO_URL=
FA_MONGO_DBNAME=
FA_MONGO_DEBUG=false

# DB POSTGRESQL
FA_POSTGRES_URL=

# JWT
JWT_SECRET=
JWT_ALGORITHM=HS256

# MS NOTIFICATION
MS_NOTIFICATION_URL=
MS_NOTIFICATION_SECRET=

# CRON JOBS
BALANCE_CHECK_CRON=0 * * * *